{
  "name": "webapp-skull",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "turbo build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm api:check && pnpm docs:check && pnpm project:check && pnpm build",
    "api:check": "node scripts/api-contract.mjs check",
    "api:generate": "node scripts/api-contract.mjs generate",
    "db:generate": "turbo db:generate --filter=@workspace/database",
    "db:migrate": "turbo db:migrate --filter=@workspace/database",
    "db:seed": "turbo db:seed --filter=@workspace/api",
    "db:studio": "turbo db:studio --filter=@workspace/database",
    "dev": "turbo dev",
    "dev:down": "docker compose down",
    "dev:infra": "docker compose up -d --wait",
    "docs:check": "node scripts/docs-check.mjs",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "project:check": "node scripts/project-check.mjs",
    "setup": "node scripts/setup.mjs",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "test:integration": "node scripts/test-auth.mjs integration",
    "test:e2e": "node scripts/test-auth.mjs e2e"
  },
  "devDependencies": {
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "2.9.18",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12"
  }
}
