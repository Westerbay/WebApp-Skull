# Local PostgreSQL container
POSTGRES_DB=webapp_skull
POSTGRES_USER=webapp_skull
POSTGRES_PASSWORD=webapp_skull_dev
POSTGRES_PORT=5433

# Backend
API_PORT=3001
DATABASE_URL=postgresql://webapp_skull:webapp_skull_dev@localhost:5433/webapp_skull
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# Frontend, safe to expose to browser
VITE_API_URL=http://localhost:3001

# Application environment is distinct from NODE_ENV (staging builds are production builds).
APP_ENV=development
# Required explicitly before a seed command can write fixtures.
DATABASE_FIXTURE_MODE=enabled
EMAIL_MODE=capture
EMAIL_FROM=no-reply@example.test
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
# SMTP_USER / SMTP_PASSWORD: required only for explicitly configured production SMTP.
# EMAIL_ALLOWED_RECIPIENTS: comma-separated exact addresses, required for staging SMTP.

# Logging: defaults to pretty in development, JSON elsewhere.
# LOG_FORMAT=json
# LOG_LEVEL=debug
# LOG_FILE: development-only JSON mirror; pnpm dev:logs sets it automatically.
