    {
      "title": "Valkey server events",
      "type": "timeseries",
      "description": "Evictions and rejected connections reported by the server. Counters reset on server restart.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (event) (rate(skull_valkey_server_events_total{environment=~\"$environment\",service_name=~\"$service\",instance_id=~\"$instance_id\"}[$__rate_interval]))",
          "legendFormat": "{{event}}",
          "queryType": "range"
        }
