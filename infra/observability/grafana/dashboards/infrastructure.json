    {
      "title": "SQL executions",
      "type": "timeseries",
      "description": "Current database and application role, including monitoring SQL. Replicas observing the same database/role are deduplicated with max. Source resets and entry eviction can distort rates; these are diagnostic trends, not billing or SLO counters.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (environment, service_name) (rate(webapp_template_postgres_statements_calls_total{environment=~\"$environment\",service_name=~\"$service\"}[$__rate_interval]) and on (service_name, environment, instance) (webapp_template_postgres_statements_up{environment=~\"$environment\",service_name=~\"$service\"} == 1))",
          "legendFormat": "SQL executions/s",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 18,
      "gridPos": {
        "x": 8,
        "y": 32,
        "w": 8,
        "h": 8
      }
    },
    {
      "title": "Mean SQL execution time",
      "type": "timeseries",
      "description": "Current database and application role, including monitoring SQL. Replicas observing the same database/role are deduplicated with max. Source resets and entry eviction can distort rates; these are diagnostic trends, not billing or SLO counters. Weighted mean over the selected rate window, not a percentile or API response time.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (environment, service_name) (rate(webapp_template_postgres_statements_execution_seconds_total{environment=~\"$environment\",service_name=~\"$service\"}[$__rate_interval]) and on (service_name, environment, instance) (webapp_template_postgres_statements_up{environment=~\"$environment\",service_name=~\"$service\"} == 1)) / (max by (environment, service_name) (rate(webapp_template_postgres_statements_calls_total{environment=~\"$environment\",service_name=~\"$service\"}[$__rate_interval]) and on (service_name, environment, instance) (webapp_template_postgres_statements_up{environment=~\"$environment\",service_name=~\"$service\"} == 1)) > 0)",
          "legendFormat": "Mean SQL execution",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
