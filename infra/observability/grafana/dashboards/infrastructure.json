{
  "uid": "skull-api-infrastructure",
  "title": "Skull API infrastructure",
  "description": "Operational signals for Skull API. No data means unknown. See docs/OBSERVABILITY.md for scope, thresholds and runbooks.",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "tags": ["skull", "observability"],
  "editable": false,
  "annotations": {
    "list": [
      {
        "name": "Deployments",
        "enable": true,
        "iconColor": "#5794F2",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "target": {
          "expr": "{service_name=~\"$service\",environment=~\"$environment\",instance_id=~\"$instance_id\"} | json | __error__=\"\" | event=\"api.started\" | line_format \"Started version {{.version}}\"",
          "refId": "Deployments"
        },
        "tagKeys": "version",
        "titleFormat": "API started",
        "textFormat": "{{line}}"
      }
    ]
  },
  "links": [
    {
      "title": "API overview",
      "type": "link",
      "url": "/d/skull-api-overview",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "API routes and logs",
      "type": "link",
      "url": "/d/skull-api-logs",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "API auth and email",
      "type": "link",
      "url": "/d/skull-api-auth-email",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(skull_build_info, environment)",
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "development",
          "value": "development"
        }
      },
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "skull-api",
        "current": {
          "text": "skull-api",
          "value": "skull-api"
        }
      },
      {
        "name": "instance_id",
        "label": "API instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(skull_build_info{service_name=~\"$service\",environment=~\"$environment\"}, instance_id)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "route",
        "label": "Route (regex)",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      },
      {
        "name": "method",
        "label": "Method",
        "type": "custom",
        "query": "GET,HEAD,POST,PUT,PATCH,DELETE,OPTIONS,OTHER",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "title": "CPU used by API",
      "type": "timeseries",
      "description": "CPU cores used by the Node.js process; not host CPU percentage.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{environment=~\"$environment\",service_name=~\"$service\",instance_id=~\"$instance_id\"}[$__rate_interval])",
          "legendFormat": "{{instance_id}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      }
    },
    {
      "title": "API memory",
