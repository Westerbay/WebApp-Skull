        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{environment=~\"$environment\",service_name=~\"$service\",instance_id=~\"$instance_id\"}",
          "legendFormat": "RSS {{instance_id}}",
          "queryType": "range"
        },
        {
          "refId": "B",
          "expr": "nodejs_heap_size_used_bytes{environment=~\"$environment\",service_name=~\"$service\",instance_id=~\"$instance_id\"}",
          "legendFormat": "Heap used {{instance_id}}",
          "queryType": "range"
        },
        {
          "refId": "C",
          "expr": "nodejs_heap_size_total_bytes{environment=~\"$environment\",service_name=~\"$service\",instance_id=~\"$instance_id\"}",
          "legendFormat": "Heap allocated {{instance_id}}",
