              "dependency": 1,
              "state": 2,
              "kind": 3,
              "version": 4,
              "environment": 5,
              "Value": 6
            },
            "renameByName": {
              "instance_id": "API instance",
              "version": "Version",
              "environment": "Environment",
              "Value": "Value"
            }
          }
        }
      ]
    },
