    {
      "title": "Dependency configuration",
      "type": "table",
      "description": "Valkey zero means intentionally disabled, not unavailable.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "skull_dependency_enabled{environment=~\"$environment\",service_name=~\"$service\",instance_id=~\"$instance_id\"}",
          "legendFormat": "Dependency configuration",
          "queryType": "range",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
