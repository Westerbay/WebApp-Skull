    {
      "title": "Observed restarts",
      "type": "stat",
      "description": "Detects restarts only for stable instance identities with samples before and after the restart. It is not a container restart counter.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "changes(process_start_time_seconds{environment=~\"$environment\",service_name=~\"$service\",instance_id=~\"$instance_id\"}[$__range])",
          "legendFormat": "Observed restarts",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "id": 5,
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 8
      }
