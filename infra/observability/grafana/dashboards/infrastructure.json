      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "webapp_template_dependency_enabled{environment=~\"$environment\",service_name=~\"$service\",instance_id=~\"$instance_id\"}",
          "legendFormat": "Dependency configuration",
          "queryType": "range",
          "instant": true,
          "range": false,
          "format": "table"
