    {
      "title": "Garbage collection p95",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(.95, sum by (le, kind) (rate(nodejs_gc_duration_seconds_bucket{environment=~\"$environment\",service_name=~\"$service\",instance_id=~\"$instance_id\"}[$__rate_interval])))",
          "legendFormat": "{{kind}}",
          "queryType": "range"
        }
      ],
