{
  "uid": "skull-api-logs",
  "title": "Skull API logs",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": ["skull", "logs"],
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values({service_name=\"skull-api\"}, environment)",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "development",
          "value": "development"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "API logs",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"skull-api\",environment=\"$environment\"} | json"
        }
      ],
      "options": {
        "showTime": true,
        "showLogDetails": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Errors",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"skull-api\",environment=\"$environment\"} | json | level >= 50"
        }
      ],
      "options": {
        "showTime": true,
        "showLogDetails": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    }
  ]
}
