// Integration collector: only opt-in containers in the configured environment.
// Loki/Grafana and network/access controls are provided by the target platform.
discovery.docker "applications" {
  host = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
  filter {
    name = "label"
    values = ["skull.logs=true", "skull.logs.environment=" + sys.env("APP_ENV")]
  }
}

discovery.relabel "applications" {
  targets = discovery.docker.applications.targets
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label = "service_name"
  }
}

loki.source.docker "applications" {
  host = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
  targets = discovery.relabel.applications.output
  labels = { environment = sys.env("APP_ENV") }
  forward_to = [loki.process.applications.receiver]
}

loki.process "applications" {
  stage.json {
    expressions = {
      service_name = "service_name",
      time = "time",
    }
  }
  stage.labels {
    values = {
      service_name = "",
    }
  }
  stage.timestamp {
    source = "time"
    format = "UnixMs"
    action_on_failure = "skip"
  }
  forward_to = [loki.write.remote.receiver]
}

loki.write "remote" {
  endpoint {
    url = sys.env("LOKI_URL")
    bearer_token_file = sys.env("LOKI_TOKEN_FILE")
    tenant_id = sys.env("LOKI_TENANT_ID")
  }
}
