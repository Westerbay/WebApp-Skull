// Host development: only the API's sanitized JSON file is collected.
local.file_match "api" {
  path_targets = [{
    "__path__" = "/var/log/skull/api.jsonl",
    "service_name" = "skull-api",
  }]
  sync_period = "1s"
}

loki.source.file "api" {
  targets = local.file_match.api.targets
  forward_to = [loki.process.api.receiver]
}

loki.process "api" {
  stage.json {
    expressions = {
      environment = "environment",
      time = "time",
      instance_id = "instance_id",
    }
  }
  stage.labels {
    values = {
      environment = "",
      instance_id = "",
    }
  }
  stage.timestamp {
    source = "time"
    format = "UnixMs"
    action_on_failure = "skip"
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// Embedded upstream exporters own connection management and collection.
// Separate PostgreSQL exporters keep optional statistics failures independent.
prometheus.exporter.postgres "database" {
  data_source_names = [sys.env("OBS_POSTGRES_DSN")]
  disable_default_metrics = true
  disable_settings_metrics = true
  custom_queries_config_path = "/etc/alloy/postgres.yml"
}

prometheus.exporter.postgres "statements" {
  data_source_names = [sys.env("OBS_POSTGRES_DSN")]
  disable_default_metrics = true
  disable_settings_metrics = true
  custom_queries_config_path = "/etc/alloy/postgres-statements.yml"
}

prometheus.exporter.redis "valkey" {
  redis_addr = sys.env("OBS_VALKEY_URL")
  connection_timeout = "2s"
  redis_metrics_only = true
  export_key_values = false
}
