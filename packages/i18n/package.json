{
  "name": "@workspace/i18n",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "paraglide-js compile --project ./project.inlang --outdir ./src/generated --strategy baseLocale --emit-ts-declarations",
    "dev": "paraglide-js compile --project ./project.inlang --outdir ./src/generated --watch --strategy baseLocale --emit-ts-declarations",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    "./config": "./src/config.ts",
    "./messages": "./src/generated/messages.js",
    "./runtime": "./src/generated/runtime.js"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.23.1",
    "typescript": "5.9.3"
  }
}
